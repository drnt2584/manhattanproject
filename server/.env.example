# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=127.0.0.1                      # only cloudflared talks to the app
PUBLIC_URL=https://notify.example.com
APP_TIMEZONE=Asia/Kuala_Lumpur      # used for schedules and the dashboard
LOG_LEVEL=info
LOG_FILE=/usr/local/var/log/notify/app.log

DATABASE_URL=postgres://notify:CHANGE_ME@127.0.0.1:5432/notify
DB_POOL_MAX=10
# true when DATABASE_URL uses the restricted notify_app role from deploy/db-roles.sql
# (then run `DATABASE_URL=<owner url> npm run migrate` after each upgrade)
SKIP_MIGRATIONS=false

# openssl rand -hex 32
SESSION_SECRET=
SESSION_HOURS=12
# First admin account (created on first start if it does not exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Who gets the consolidated failure report after each run (comma separated)
ADMIN_NOTIFY_EMAILS=admin@example.com

# ── Contact data ────────────────────────────────────────────────────
# Country code added to local numbers like 012-345 6789 (digits only: 60 Malaysia, 65 Singapore…)
DEFAULT_COUNTRY_CODE=60
AMOUNT_LOCALE=en-MY
AMOUNT_CURRENCY=MYR                 # {{amount_formatted}} renders "RM 1,234.50"
AMOUNT_DECIMALS=2
DATE_FORMAT=DMY                     # how to read 03/04/2026 in the sheet: DMY (Malaysia) or MDY (US)
MAX_UPLOAD_MB=10
# Optional: service account JSON for private Google Sheets (share the sheet with its email)
GOOGLE_SERVICE_ACCOUNT_FILE=

# ── Chat channels ───────────────────────────────────────────────────
# Each person gets ONE chat message: Telegram if they joined the bot, otherwise WhatsApp
# (if enabled). Email is sent in addition whenever they have an address.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=                 # from @BotFather; empty = mock mode (nothing really sent)
TELEGRAM_CONCURRENCY=5

# ── WhatsApp Business Cloud API (Meta) ──────────────────────────────
WHATSAPP_ENABLED=false              # turn on once Meta has approved the templates
WHATSAPP_PROVIDER=mock              # mock | meta
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=              # permanent System User token
WHATSAPP_APP_SECRET=                # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=              # any random string; paste the same value in Meta's webhook setup
WHATSAPP_CONCURRENCY=5

# ── Email ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock                 # mock | smtp
EMAIL_FROM="Your Company <notifications@example.com>"
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=                          # Google Workspace: an App Password
EMAIL_CONCURRENCY=3

# Reading replies (IMAP) — the mailbox that receives replies to EMAIL_FROM / EMAIL_REPLY_TO
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_MS=60000

# ── Worker ──────────────────────────────────────────────────────────
WORKER_POLL_MS=5000
SEND_MAX_ATTEMPTS=3
SEND_RETRY_BASE_MS=1000
